# openab EnvironmentFile — install to /etc/openab/openab.env with mode 0600.
#
# This file is read by systemd (EnvironmentFile=). Put credentials here, not in
# the unit file. Format is KEY=value, no "export", no shell expansion.

# --- channels --------------------------------------------------------------
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# --- logging ---------------------------------------------------------------
# RUST_LOG=openab=info

# --- proxy (optional) ------------------------------------------------------
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
