# Example EnvironmentFile for /etc/openab/openab.env
# Copy, fill values locally, and never commit real tokens.
#
# Referenced from packaging/systemd/openab.service as:
#   EnvironmentFile=-/etc/openab/openab.env

# Discord
# DISCORD_BOT_TOKEN=

# Slack (Socket Mode)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# Optional overrides of unit defaults (uncomment to change):
# HOME=
# PATH=
# OPENAB_HOME=
# OPENAB_WORK_DIR=
# OPENAB_LOG_DIR=
# TMPDIR=
# TEMP=
# TMP=
# OPENAB_AUTO_UPDATE=false

# Agent / provider secrets as needed by config.toml ${VAR} expansion:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
